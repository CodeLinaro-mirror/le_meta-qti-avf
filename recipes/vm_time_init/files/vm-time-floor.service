[Unit]
Description=VM boot time floor - prevent epoch time breaking cert validation
DefaultDependencies=no
Before=network-pre.target sysinit.target
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/vm-time-floor.sh
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target

