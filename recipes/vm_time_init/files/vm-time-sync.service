[Unit]
Description=VM host RTC time sync
After=vm-time-floor.service init_post_boot.service

[Service]
Type=oneshot
ExecStart=/usr/bin/vm-time-sync.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
